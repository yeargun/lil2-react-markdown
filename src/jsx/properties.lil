// property-information `find` plus `hastToReact`, reduced to what hast-util-to-jsx-runtime reads:
// the React prop key of a hast property name, and whether its list value is comma-separated.

import { htmlKeys, svgKeys } from "./properties-data.lil";

extern JsValue Object;

Regex dash = new Regex("-[a-z]", "g");
Regex valid = new Regex("^data[-\\w.:]+$", "i");

// "key" or "key," (comma-separated).
export string reactKey(bool svg, string name) {
  string normal = name.toLowerCase();
  JsValue table = if (svg) { svgKeys } else { htmlKeys };
  if (bool(Object.hasOwn(table, normal))) {
    return JS.assume(table[normal]);
  }
  string value = name;
  if (normal.length > 4 && normal.slice(0, 4) == "data" && valid.test(name)) {
    if (name.charAt(4) != "-") {
      string rest = name.slice(4);
      if (!dash.test(rest)) {
        string dashes = "";
        for (int index = 0; index < rest.length; index++) {
          int code = rest.codeUnitAt(index);
          dashes += if (code >= 65 && code <= 90) { "-" + rest.charAt(index).toLowerCase() } else { rest.charAt(index) };
        }
        if (dashes.charAt(0) != "-") {
          dashes = "-" + dashes;
        }
        value = "data" + dashes;
      }
    }
  }
  return value;
}

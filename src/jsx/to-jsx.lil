// hast-util-to-jsx-runtime 2.3.6 (production `jsx`/`jsxs` path): a hast arena to React elements.
// React's functions and components are host values; everything before them is typed. Tags and properties
// are ints: a name is read from its table only where React needs it (the element type, a prop key).

import { H_ELEMENT, H_ROOT, H_TEXT, P_BOOLEAN, P_FLOAT, P_KEYWORD, P_NUMBER, P_STRING, PROP_ALIGN, TAG_SVG, TAG_TABLE, TAG_TBODY, TAG_TD, TAG_TH, TAG_THEAD, TAG_TR, Hast, keywordNames, propId, tagNames } from "../hast/hast.lil";
import { propComma, propCommaSvg, propReact, propReactSvg } from "../hast/properties.lil";

extern JsValue Number;

export class JsxOptions {
  JsValue Fragment;
  JsValue jsx;
  JsValue jsxs;
  // Components by tag id (`undefined`: the tag name itself).
  JsValue[] components;
  bool passKeys;
  bool passNode;
  bool tableCellAlignToStyle;
  // `style` strings become React style objects through this (style-to-js); only a layer that creates `style`
  // properties (rehype-katex) installs it.
  bool styles;
  func(string)->JsValue parseStyle;
  // Upstream's `ignoreInvalidStyle`: a style that does not parse becomes `{}` instead of throwing.
  bool ignoreInvalidStyle;

  init(JsValue Fragment, JsValue jsx, JsValue jsxs, JsValue[] components) {
    this.Fragment = Fragment;
    this.jsx = jsx;
    this.jsxs = jsxs;
    this.components = components;
    this.passKeys = true;
    this.passNode = false;
    this.tableCellAlignToStyle = true;
    this.styles = false;
    this.parseStyle = (string value) => value;
    this.ignoreInvalidStyle = false;
  }
}

class JsxState {
  Hast h;
  JsxOptions options;
  bool svg;
  JsValue columns;
  // The id of the `style` property (-1: none was defined).
  int styleProp;
  // Keys (`passKeys`): each element's index among its same-tag siblings, counted per children list before
  // any of them renders. By tag: the list that counted it last, and its count there.
  int[] keyIndex;
  int[] countedIn;
  int[] counts;

  init(Hast h, JsxOptions options) {
    this.h = h;
    this.options = options;
    this.svg = false;
    this.columns = JS.undefined();
    this.styleProp = if (options.styles) { propId("style") } else { -1 };
    this.keyIndex = [];
    this.countedIn = [];
    this.counts = [];
    if (options.passKeys) {
      for (int node = 0; node < h.kind.length; node++) {
        this.keyIndex.push(0);
      }
      for (int tag = 0; tag < tagNames.length; tag++) {
        this.countedIn.push(-1);
        this.counts.push(0);
      }
    }
  }
}

// hast-util-whitespace on a string: only [ \t\n\f\r].
bool whitespace(string value) {
  for (int index = 0; index < value.length; index++) {
    int code = value.codeUnitAt(index);
    if (code != 32 && code != 9 && code != 10 && code != 12 && code != 13) {
      return false;
    }
  }
  return true;
}

// `keyTag` > 0 gives the element the key `tagName-keyIndex`.
JsValue create(JsxState state, JsValue type, JsValue props, bool staticChildren, int keyTag, int keyIndex) {
  JsValue fn = if (staticChildren) { state.options.jsxs } else { state.options.jsx };
  if (keyTag > 0) {
    return fn(type, props, tagNames[keyTag] + "-" + keyIndex);
  }
  return fn(type, props);
}

// The hast tree as positional columns (the arena's arrays), shared by every element of a render:
//   [0] kind  [1] parent  [2] firstChild  [3] nextSibling  [4] tag  [5] value  [6] startOffset
//   [7] endOffset  [8] flags  [9] meta  [10] propHead  [11] propName  [12] propKind  [13] propString
//   [14] propNumber  [15] propNext  [16] lineStarts  [17] tagNames
export JsValue hastColumns(Hast h) {
  return [h.kind, h.parent, h.firstChild, h.nextSibling, h.tag, h.value, h.sOffset, h.eOffset, h.flags, h.meta, h.propHead, h.pProp, h.pKind, h.pStr, h.pNum, h.pNext, h.lineStarts, tagNames];
}

// hast-util-to-jsx-runtime's `parseStyle`.
JsValue styleObject(JsxState state, string value) {
  try {
    return state.options.parseStyle(value);
  } catch (JsValue error) {
    if (state.options.ignoreInvalidStyle) {
      return object {};
    }
    throw error;
  }
}

JsValue createElementProps(JsxState state, int node) {
  Hast h = state.h;
  JsValue props = object {};
  string alignValue = "";
  bool cell = h.tag[node] == TAG_TD || h.tag[node] == TAG_TH;
  int prop = h.propHead[node];
  while (prop >= 0) {
    int name = h.pProp[prop];
    string key = if (state.svg) { propReactSvg[name] } else { propReact[name] };
    int kind = h.pKind[prop];
    JsValue value = JS.undefined();
    if (kind == P_STRING) {
      // React only accepts `style` as an object.
      value = if (name == state.styleProp) { styleObject(state, h.pStr[prop]) } else { h.pStr[prop] };
    } else if (kind == P_NUMBER) {
      value = h.pNum[prop];
    } else if (kind == P_BOOLEAN) {
      value = h.pNum[prop] != 0;
    } else if (kind == P_KEYWORD) {
      value = keywordNames[h.pNum[prop]];
    } else if (kind == P_FLOAT) {
      value = Number(h.pStr[prop]);
    } else {
      string joined = h.pStr[prop];
      bool comma = if (state.svg) { propCommaSvg[name] } else { propComma[name] };
      value = if (comma) { joined.split(" ").join(", ").trim() } else { joined.trim() };
    }
    if (state.options.tableCellAlignToStyle && name == PROP_ALIGN && (kind == P_KEYWORD || kind == P_STRING) && cell) {
      alignValue = JS.assume(value);
    } else {
      props[key] = value;
    }
    prop = h.pNext[prop];
  }
  if (alignValue != "") {
    JsValue style = props["style"];
    if (!bool(style)) {
      style = object {};
      props["style"] = style;
    }
    style["textAlign"] = alignValue;
  }
  return props;
}

JsValue one(JsxState state, int node, int keyTag) {
  Hast h = state.h;
  int kind = h.kind[node];
  if (kind == H_ELEMENT) {
    return element(state, node, keyTag);
  }
  if (kind == H_ROOT) {
    JsValue props = object {};
    bool staticChildren = addChildren(props, createChildren(state, node));
    return create(state, state.options.Fragment, props, staticChildren, keyTag, 0);
  }
  if (kind == H_TEXT) {
    return h.value[node];
  }
  return JS.undefined();
}

JsValue element(JsxState state, int node, int keyTag) {
  Hast h = state.h;
  bool parentSvg = state.svg;
  int tag = h.tag[node];
  if (tag == TAG_SVG && !parentSvg) {
    state.svg = true;
  }
  JsValue[] components = state.options.components;
  JsValue component = if (tag < components.length) { components[tag] } else { JS.undefined() };
  JsValue type = if (JS.isUndefined(component)) { tagNames[tag] } else { component };
  JsValue props = createElementProps(state, node);
  JsValue[] children = createChildren(state, node);
  if (tag == TAG_TABLE || tag == TAG_TBODY || tag == TAG_THEAD || tag == TAG_TR) {
    children = children.filter((JsValue child) => !(JS.typeOf(child) == "string" && whitespace(JS.assume(child))));
  }
  // `passNode`: a component gets its node as an id into `tree`, the columns (one array per render).
  if (state.options.passNode && JS.typeOf(type) != "string" && !JS.strictEqual(type, state.options.Fragment)) {
    if (JS.isUndefined(state.columns)) {
      state.columns = hastColumns(h);
    }
    props["node"] = node;
    props["tree"] = state.columns;
  }
  bool staticChildren = addChildren(props, children);
  state.svg = parentSvg;
  return create(state, type, props, staticChildren, keyTag, if (keyTag > 0) { state.keyIndex[node] } else { 0 });
}

JsValue[] createChildren(JsxState state, int node) {
  Hast h = state.h;
  bool keys = state.options.passKeys;
  if (keys) {
    int counted = h.firstChild[node];
    while (counted >= 0) {
      if (h.kind[counted] == H_ELEMENT) {
        int tag = h.tag[counted];
        while (state.counts.length <= tag) {
          state.countedIn.push(-1);
          state.counts.push(0);
        }
        if (state.countedIn[tag] != node) {
          state.countedIn[tag] = node;
          state.counts[tag] = 0;
        }
        state.keyIndex[counted] = state.counts[tag];
        state.counts[tag] = state.counts[tag] + 1;
      }
      counted = h.nextSibling[counted];
    }
  }
  JsValue[] children = [];
  int child = h.firstChild[node];
  while (child >= 0) {
    JsValue result = one(state, child, if (keys && h.kind[child] == H_ELEMENT) { h.tag[child] } else { 0 });
    if (!JS.isUndefined(result)) {
      children.push(result);
    }
    child = h.nextSibling[child];
  }
  return children;
}

// Sets `props.children`; true when that is an array (React's `jsxs`).
bool addChildren(JsValue props, JsValue[] children) {
  if (children.length > 0) {
    JsValue value = if (children.length > 1) { children } else { children[0] };
    if (bool(value)) {
      props["children"] = value;
      return children.length > 1;
    }
  }
  return false;
}

// Components given as flat pairs, `[tag, component, tag, component, ...]`, as a dense array by tag id.
export JsValue[] componentTable(JsValue pairs) {
  JsValue[] table = [];
  if (JS.isArray(pairs)) {
    int length = JS.number(pairs["length"]).toInt();
    for (int index = 0; index + 1 < length; index += 2) {
      int tag = JS.number(pairs[index]).toInt();
      while (table.length <= tag) {
        table.push(JS.undefined());
      }
      table[tag] = pairs[index + 1];
    }
  }
  return table;
}

// `toJsxRuntime(tree, options)` for the root `node` of `h`.
export JsValue toJsxRuntime(Hast h, int node, JsxOptions options) {
  JsxState state = new JsxState(h, options);
  JsValue result = one(state, node, 0);
  if (bool(result) && JS.typeOf(result) != "string") {
    return result;
  }
  JsValue props = object {};
  props["children"] = if (bool(result)) { result } else { JS.undefined() };
  return create(state, options.Fragment, props, false, 0, 0);
}

// The GFM plugin (remark-gfm 4.0.1), registered when this module loads. Its option is the Markdown prop
// `singleTilde` (default true).

import { SyntaxExtension } from "./micromark/parse.lil";
import { PLUGIN_GFM, Pipeline, register } from "./plugins.lil";
import { gfmMdast, gfmSyntax } from "./gfm/gfm.lil";

// The syntax for each `singleTilde`, made on first use and kept: the same objects every render let the parser
// reuse its combined constructs.
SyntaxExtension[] withSingleTilde = [];
SyntaxExtension[] withoutSingleTilde = [];

void installGfm(Pipeline p) {
  JsValue singleTilde = p.options["singleTilde"];
  bool single = JS.isUndefined(singleTilde) || bool(singleTilde);
  SyntaxExtension[] kept = if (single) { withSingleTilde } else { withoutSingleTilde };
  if (kept.length == 0) {
    for (SyntaxExtension extension of gfmSyntax(single)) {
      kept.push(extension);
    }
  }
  for (SyntaxExtension extension of kept) {
    p.syntax.push(extension);
  }
  p.mdast.push(gfmMdast);
}

export bool gfmRegistered = register(PLUGIN_GFM, installGfm);

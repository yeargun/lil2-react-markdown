// The math plugins: remark-math 6.0.0 (option: the Markdown prop `singleDollarTextMath`, default true) and
// rehype-katex 7.0.1 (option: the Markdown prop `katex`, KaTeX's options), registered when this module loads.

import { PLUGIN_KATEX, PLUGIN_MATH, Pipeline, register } from "./plugins.lil";
import { mathHast, mathMdast, mathSyntax } from "./math/math.lil";
import { rehypeKatex } from "./katex/rehype-katex.lil";
import { Hast } from "./hast/hast.lil";
import { parseStyle } from "./jsx/style.lil";

void installMath(Pipeline p) {
  JsValue single = p.options["singleDollarTextMath"];
  p.syntax.push(mathSyntax(JS.isNullish(single) || bool(single)));
  p.mdast.push(mathMdast);
  p.hast.push(mathHast);
}

void installKatex(Pipeline p) {
  JsValue settings = p.options["katex"];
  p.rehype.push((Hast h, int root) => rehypeKatex(h, root, settings));
  p.styles = true;
  p.parseStyle = parseStyle;
}

export bool mathRegistered = register(PLUGIN_MATH, installMath);
export bool katexRegistered = register(PLUGIN_KATEX, installKatex);

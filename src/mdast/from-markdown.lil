// mdast-util-from-markdown 2.0.3: micromark events to an mdast arena (`Tree`).

import { CR, LF } from "../micromark/codes.lil";
import { tAtxHeading, tListItem, tAtxHeadingSequence, tAutolink, tAutolinkEmail, tAutolinkProtocol, tBlockQuote, tBlockQuoteMarker, tBlockQuotePrefix, tBlockQuotePrefixWhitespace, tCharacterEscape, tCharacterEscapeValue, tCharacterReference, tCharacterReferenceMarkerHexadecimal, tCharacterReferenceMarkerNumeric, tCharacterReferenceValue, tCodeFenced, tCodeFencedFence, tCodeFencedFenceInfo, tCodeFencedFenceMeta, tCodeFlowValue, tCodeIndented, tCodeText, tCodeTextData, tData, tDefinition, tDefinitionDestinationString, tDefinitionLabelString, tDefinitionTitleString, tEmphasis, tHardBreakEscape, tHardBreakTrailing, tHtmlFlow, tHtmlFlowData, tHtmlText, tHtmlTextData, tImage, tLabel, tLabelText, tLineEnding, tLineEndingBlank, tLinePrefix, tLink, tListItemIndent, tListItemMarker, tListItemPrefix, tListItemPrefixWhitespace, tListItemValue, tListOrdered, tListUnordered, tParagraph, tReference, tReferenceString, tResource, tResourceDestinationString, tResourceTitleString, tSetextHeading, tSetextHeadingLineSequence, tSetextHeadingText, tStrong, tThematicBreak } from "../micromark/types.lil";
import { Parser, Tokens, enterEvent, eventToken, exitEvent, isEnter, serializeToken, splice } from "../micromark/tokenizer.lil";
import { decodeNamed, decodeNumeric, decodeString, normalizeIdentifier } from "../micromark/util.lil";
import { K_BLOCKQUOTE, K_BREAK, K_CODE, K_DEFINITION, K_EMPHASIS, K_FRAGMENT, K_HEADING, K_HTML, K_IMAGE, K_IMAGE_REFERENCE, K_INLINE_CODE, K_LINK, K_LINK_REFERENCE, K_LIST, K_LIST_ITEM, K_PARAGRAPH, K_ROOT, K_STRONG, K_TEXT, K_THEMATIC_BREAK, N_CHECKED_SET, N_HAS_POSITION, N_END_SET, N_IDENTIFIER_SET, N_LABEL_SET, N_ORDERED, N_S2_SET, N_S3_SET, N_SPREAD, N_START_SET, N_URL_SET, Tree, toString } from "./tree.lil";

// Synthetic list item tokens (`tListItem`; upstream makes `{type: 'listItem', _spread}` events in
// `prepareList`) carry this flag.
export const int F_SPREAD = 256;

func(FromMarkdown, int)->void noHandler = (FromMarkdown c, int token) => {};

export class FromMarkdown {
  Parser parser;
  Tokens tokens;
  Tree tree;
  int[] stack;
  int[] tokenStack;
  (func(FromMarkdown, int)->void)[] enter;
  (func(FromMarkdown, int)->void)[] exit;
  int[] canContainEols;
  (func(Tree)->void)[] transforms;
  // Upstream's `this.data`.
  bool expectingFirstListItemValue;
  bool flowCodeInside;
  bool setextHeadingSlurpLineEnding;
  bool atHardBreak;
  bool inReference;
  int referenceType;
  int characterReferenceType;

  init(Parser parser) {
    this.parser = parser;
    this.tokens = parser.tokens;
    this.tree = new Tree();
    this.stack = [];
    this.tokenStack = [];
    this.enter = [];
    this.exit = [];
    this.canContainEols = [K_EMPHASIS, K_FRAGMENT, K_HEADING, K_PARAGRAPH, K_STRONG];
    this.transforms = [];
    this.expectingFirstListItemValue = false;
    this.flowCodeInside = false;
    this.setextHeadingSlurpLineEnding = false;
    this.atHardBreak = false;
    this.inReference = false;
    this.referenceType = -1;
    this.characterReferenceType = -1;
  }

  void on(bool entering, int type, func(FromMarkdown, int)->void handle) {
    (func(FromMarkdown, int)->void)[] table = if (entering) { this.enter } else { this.exit };
    while (table.length <= type) {
      table.push(noHandler);
    }
    table[type] = handle;
  }

  string slice(int token) {
    return serializeToken(this.parser, token, false);
  }

  int top() {
    return this.stack[this.stack.length - 1];
  }

  int below() {
    return this.stack[this.stack.length - 2];
  }

  void setStart(int node, int token) {
    this.tree.sOffset[node] = this.tokens.sOffset[token];
    this.tree.set(node, N_HAS_POSITION);
  }

  void setEnd(int node, int token) {
    this.tree.eOffset[node] = this.tokens.eOffset[token];
    this.tree.set(node, N_END_SET);
  }

  // `enter(node, token)`.
  void open(int node, int token) {
    this.tree.append(this.top(), node);
    this.stack.push(node);
    this.tokenStack.push(token);
    this.setStart(node, token);
  }

  // `exit(token)`.
  void close(int token) {
    int node = this.stack.pop();
    if (this.tokenStack.length == 0) {
      throw "Cannot close token type " + this.tokens.type[token] + ": it’s not open";
    }
    int open = this.tokenStack.pop();
    if (this.tokens.type[open] != this.tokens.type[token]) {
      throw "Cannot close token type " + this.tokens.type[token] + ": a different token (type " + this.tokens.type[open] + ") is open";
    }
    this.setEnd(node, token);
  }

  void buffer() {
    this.stack.push(this.tree.create(K_FRAGMENT, 0));
  }

  string resume() {
    return toString(this.tree, this.stack.pop());
  }

  void onEnterData(int token) {
    int node = this.top();
    int tail = this.tree.lastChild[node];
    if (tail < 0 || this.tree.kind[tail] != K_TEXT) {
      tail = this.tree.create(K_TEXT, 0);
      this.setStart(tail, token);
      this.tree.append(node, tail);
    }
    this.stack.push(tail);
  }

  void onExitData(int token) {
    int tail = this.stack.pop();
    this.tree.s1[tail] = this.tree.s1[tail] + this.slice(token);
    this.setEnd(tail, token);
  }

  // Upstream's prepareList: adds listItem events and computes spread.
  int prepareList(int[] events, int start, int length) {
    Tokens tokens = this.tokens;
    int index = start - 1;
    int containerBalance = -1;
    bool listSpread = false;
    int listItem = -1;
    int lineIndex = -1;
    int firstBlankLineIndex = -1;
    bool atMarker = false;
    int end = length;
    while (++index <= end) {
      int event = events[index];
      int token = eventToken(event);
      int type = tokens.type[token];
      if (type == tListUnordered || type == tListOrdered || type == tBlockQuote) {
        if (isEnter(event)) {
          containerBalance++;
        } else {
          containerBalance--;
        }
        atMarker = false;
      } else if (type == tLineEndingBlank) {
        if (isEnter(event)) {
          if (listItem >= 0 && !atMarker && containerBalance == 0 && firstBlankLineIndex <= 0) {
            firstBlankLineIndex = index;
          }
          atMarker = false;
        }
      } else if (type == tLinePrefix || type == tListItemValue || type == tListItemMarker || type == tListItemPrefix || type == tListItemPrefixWhitespace) {
        // Empty.
      } else {
        atMarker = false;
      }

      if ((containerBalance == 0 && isEnter(event) && type == tListItemPrefix) ||
          (containerBalance == -1 && !isEnter(event) && (type == tListUnordered || type == tListOrdered))) {
        if (listItem >= 0) {
          int tailIndex = index;
          lineIndex = -1;
          while (tailIndex-- > 0) {
            int tailEvent = events[tailIndex];
            int tailToken = eventToken(tailEvent);
            int tailType = tokens.type[tailToken];
            if (tailType == tLineEnding || tailType == tLineEndingBlank) {
              if (!isEnter(tailEvent)) {
                continue;
              }
              if (lineIndex > 0) {
                tokens.type[eventToken(events[lineIndex])] = tLineEndingBlank;
                listSpread = true;
              }
              tokens.type[tailToken] = tLineEnding;
              lineIndex = tailIndex;
            } else if (tailType == tLinePrefix || tailType == tBlockQuotePrefix || tailType == tBlockQuotePrefixWhitespace || tailType == tBlockQuoteMarker || tailType == tListItemIndent) {
              // Empty.
            } else {
              break;
            }
          }
          if (firstBlankLineIndex > 0 && (lineIndex <= 0 || firstBlankLineIndex < lineIndex)) {
            tokens.set(listItem, F_SPREAD);
          }
          if (lineIndex > 0) {
            tokens.endAtStartOf(listItem, eventToken(events[lineIndex]));
          } else {
            tokens.endAtEndOf(listItem, token);
          }
          int at = if (lineIndex > 0) { lineIndex } else { index };
          splice(events, at, 0, [exitEvent(listItem)]);
          index++;
          end++;
        }
        if (type == tListItemPrefix) {
          int item = tokens.create(tListItem, tokens.tokenizer[token]);
          tokens.startAtStartOf(item, token);
          listItem = item;
          splice(events, index, 0, [enterEvent(item)]);
          index++;
          end++;
          firstBlankLineIndex = -1;
          atMarker = true;
        }
      }
    }
    if (listSpread) {
      tokens.set(eventToken(events[start]), F_SPREAD);
    } else {
      tokens.clear(eventToken(events[start]), F_SPREAD);
    }
    return end;
  }

  int compile(int[] events) {
    Tree tree = this.tree;
    tree.lineStarts = this.parser.lineStarts;
    int root = tree.create(K_ROOT, 0);
    this.stack = [root];
    int[] listStack = [];
    int index = -1;
    while (++index < events.length) {
      int type = this.tokens.type[eventToken(events[index])];
      if (type == tListOrdered || type == tListUnordered) {
        if (isEnter(events[index])) {
          listStack.push(index);
        } else {
          index = this.prepareList(events, listStack.pop(), index);
        }
      }
    }
    for (int event of events) {
      int token = eventToken(event);
      int type = this.tokens.type[token];
      (func(FromMarkdown, int)->void)[] table = if (isEnter(event)) { this.enter } else { this.exit };
      if (type < table.length) {
        table[type](this, token);
      }
    }
    if (this.tokenStack.length > 0) {
      throw "Cannot close document, a token (type " + this.tokens.type[this.tokenStack[this.tokenStack.length - 1]] + ") is still open";
    }
    if (events.length > 0) {
      this.setStart(root, eventToken(events[0]));
      this.setEnd(root, eventToken(events[events.length - 2]));
    } else {
      tree.set(root, N_HAS_POSITION);
      tree.set(root, N_END_SET);
    }
    // The mdast string of every identifier id: `normalizeIdentifier(label).toLowerCase()`.
    tree.identifiers = this.parser.identifierKeys.map((string key) => key.toLowerCase());
    // Int runs extensions left on tokens (a GFM table's alignments), which nodes point into.
    tree.aux = this.tokens.aux;
    for (func(Tree)->void transform of this.transforms) {
      transform(tree);
    }
    return root;
  }
}

// `opener(create, and)`: a node of `kind` (with `flags`) opened at the token.
func(FromMarkdown, int)->void opener(int kind, int flags, bool thenBuffer) {
  return (FromMarkdown c, int token) => {
    c.open(c.tree.create(kind, flags), token);
    if (thenBuffer) {
      c.buffer();
    }
  };
}

func(FromMarkdown, int)->void closer = (FromMarkdown c, int token) => {
  c.close(token);
};

void setReferenceType(FromMarkdown c, int node) {
  Tree tree = c.tree;
  if (c.inReference) {
    tree.kind[node] = if (tree.kind[node] == K_LINK) { K_LINK_REFERENCE } else { K_IMAGE_REFERENCE };
    tree.num[node] = if (c.referenceType < 0) { 0 } else { c.referenceType };
    tree.unset(node, N_URL_SET);
    tree.unset(node, N_S2_SET);
  } else {
    tree.unset(node, N_IDENTIFIER_SET);
    tree.unset(node, N_LABEL_SET);
  }
  c.referenceType = -1;
}

string stripFenceEnds(string value) {
  int start = 0;
  int end = value.length;
  if (end > 0 && value.codeUnitAt(0) == 10) {
    start = 1;
  } else if (end > 1 && value.codeUnitAt(0) == 13 && value.codeUnitAt(1) == 10) {
    start = 2;
  } else if (end > 0 && value.codeUnitAt(0) == 13) {
    start = 1;
  }
  if (end > start && value.codeUnitAt(end - 1) == 10) {
    end -= if (end - 1 > start && value.codeUnitAt(end - 2) == 13) { 2 } else { 1 };
  } else if (end > start && value.codeUnitAt(end - 1) == 13) {
    end--;
  }
  return value.slice(start, end);
}

string stripTrailingEol(string value) {
  int end = value.length;
  if (end > 0 && value.codeUnitAt(end - 1) == 10) {
    end -= if (end > 1 && value.codeUnitAt(end - 2) == 13) { 2 } else { 1 };
  } else if (end > 0 && value.codeUnitAt(end - 1) == 13) {
    end--;
  }
  return value.slice(0, end);
}

int parseDecimal(string value) {
  int result = 0;
  for (int index = 0; index < value.length; index++) {
    result = result * 10 + (value.codeUnitAt(index) - 48);
  }
  return result;
}

export void installCommonmark(FromMarkdown c) {
  func(FromMarkdown, int)->void enterData = (FromMarkdown c, int token) => {
    c.onEnterData(token);
  };
  func(FromMarkdown, int)->void exitData = (FromMarkdown c, int token) => {
    c.onExitData(token);
  };
  func(FromMarkdown, int)->void buffer = (FromMarkdown c, int token) => {
    c.buffer();
  };
  func(FromMarkdown, int)->void exitHardBreak = (FromMarkdown c, int token) => {
    c.atHardBreak = true;
    c.close(token);
  };
  func(FromMarkdown, int)->void openLink = opener(K_LINK, 0, false);

  c.on(true, tAutolink, openLink);
  c.on(true, tAutolinkProtocol, enterData);
  c.on(true, tAutolinkEmail, enterData);
  c.on(true, tAtxHeading, opener(K_HEADING, 0, false));
  c.on(true, tBlockQuote, opener(K_BLOCKQUOTE, 0, false));
  c.on(true, tCharacterEscape, enterData);
  c.on(true, tCharacterReference, enterData);
  c.on(true, tCodeFenced, opener(K_CODE, 0, false));
  c.on(true, tCodeFencedFenceInfo, buffer);
  c.on(true, tCodeFencedFenceMeta, buffer);
  c.on(true, tCodeIndented, opener(K_CODE, 0, true));
  c.on(true, tCodeText, opener(K_INLINE_CODE, 0, true));
  c.on(true, tCodeTextData, enterData);
  c.on(true, tData, enterData);
  c.on(true, tCodeFlowValue, enterData);
  c.on(true, tDefinition, opener(K_DEFINITION, N_IDENTIFIER_SET | N_URL_SET | N_LABEL_SET, false));
  c.on(true, tDefinitionDestinationString, buffer);
  c.on(true, tDefinitionLabelString, buffer);
  c.on(true, tDefinitionTitleString, buffer);
  c.on(true, tEmphasis, opener(K_EMPHASIS, 0, false));
  c.on(true, tHardBreakEscape, opener(K_BREAK, 0, false));
  c.on(true, tHardBreakTrailing, opener(K_BREAK, 0, false));
  c.on(true, tHtmlFlow, opener(K_HTML, 0, true));
  c.on(true, tHtmlFlowData, enterData);
  c.on(true, tHtmlText, opener(K_HTML, 0, true));
  c.on(true, tHtmlTextData, enterData);
  c.on(true, tImage, opener(K_IMAGE, N_URL_SET | N_IDENTIFIER_SET | N_LABEL_SET, false));
  c.on(true, tLabel, buffer);
  c.on(true, tLink, opener(K_LINK, N_URL_SET | N_IDENTIFIER_SET | N_LABEL_SET, false));
  c.on(true, tListItem, (FromMarkdown c, int token) => {
    int node = c.tree.create(K_LIST_ITEM, if (c.tokens.has(token, F_SPREAD)) { N_SPREAD } else { 0 });
    c.open(node, token);
  });
  c.on(true, tListItemValue, (FromMarkdown c, int token) => {
    if (c.expectingFirstListItemValue) {
      int ancestor = c.below();
      c.tree.num[ancestor] = parseDecimal(c.slice(token));
      c.tree.set(ancestor, N_START_SET);
      c.expectingFirstListItemValue = false;
    }
  });
  c.on(true, tListOrdered, (FromMarkdown c, int token) => {
    int flags = N_ORDERED | (if (c.tokens.has(token, F_SPREAD)) { N_SPREAD } else { 0 });
    c.open(c.tree.create(K_LIST, flags), token);
    c.expectingFirstListItemValue = true;
  });
  c.on(true, tListUnordered, (FromMarkdown c, int token) => {
    int flags = if (c.tokens.has(token, F_SPREAD)) { N_SPREAD } else { 0 };
    c.open(c.tree.create(K_LIST, flags), token);
  });
  c.on(true, tParagraph, opener(K_PARAGRAPH, 0, false));
  c.on(true, tReference, (FromMarkdown c, int token) => {
    c.referenceType = 1;
  });
  c.on(true, tReferenceString, buffer);
  c.on(true, tResourceDestinationString, buffer);
  c.on(true, tResourceTitleString, buffer);
  c.on(true, tSetextHeading, opener(K_HEADING, 0, false));
  c.on(true, tStrong, opener(K_STRONG, 0, false));
  c.on(true, tThematicBreak, opener(K_THEMATIC_BREAK, 0, false));

  c.on(false, tAtxHeading, closer);
  c.on(false, tAtxHeadingSequence, (FromMarkdown c, int token) => {
    int node = c.top();
    if (c.tree.num[node] == 0) {
      c.tree.num[node] = c.slice(token).length;
    }
  });
  c.on(false, tAutolink, closer);
  c.on(false, tAutolinkEmail, (FromMarkdown c, int token) => {
    c.onExitData(token);
    c.tree.s1[c.top()] = "mailto:" + c.slice(token);
  });
  c.on(false, tAutolinkProtocol, (FromMarkdown c, int token) => {
    c.onExitData(token);
    c.tree.s1[c.top()] = c.slice(token);
  });
  c.on(false, tBlockQuote, closer);
  c.on(false, tCharacterEscapeValue, exitData);
  c.on(false, tCharacterReferenceMarkerHexadecimal, (FromMarkdown c, int token) => {
    c.characterReferenceType = tCharacterReferenceMarkerHexadecimal;
  });
  c.on(false, tCharacterReferenceMarkerNumeric, (FromMarkdown c, int token) => {
    c.characterReferenceType = tCharacterReferenceMarkerNumeric;
  });
  c.on(false, tCharacterReferenceValue, (FromMarkdown c, int token) => {
    string data = c.slice(token);
    string value = "";
    if (c.characterReferenceType >= 0) {
      value = decodeNumeric(data, if (c.characterReferenceType == tCharacterReferenceMarkerNumeric) { 10 } else { 16 });
      c.characterReferenceType = -1;
    } else {
      value = decodeNamed(data) ?? "";
    }
    int tail = c.top();
    c.tree.s1[tail] = c.tree.s1[tail] + value;
  });
  c.on(false, tCharacterReference, (FromMarkdown c, int token) => {
    int tail = c.stack.pop();
    c.setEnd(tail, token);
  });
  c.on(false, tCodeFenced, (FromMarkdown c, int token) => {
    string data = c.resume();
    c.tree.s1[c.top()] = stripFenceEnds(data);
    c.flowCodeInside = false;
    c.close(token);
  });
  c.on(false, tCodeFencedFence, (FromMarkdown c, int token) => {
    if (c.flowCodeInside) {
      return;
    }
    c.buffer();
    c.flowCodeInside = true;
  });
  c.on(false, tCodeFencedFenceInfo, (FromMarkdown c, int token) => {
    string data = c.resume();
    int node = c.top();
    c.tree.s2[node] = data;
    c.tree.set(node, N_S2_SET);
  });
  c.on(false, tCodeFencedFenceMeta, (FromMarkdown c, int token) => {
    string data = c.resume();
    int node = c.top();
    c.tree.s3[node] = data;
    c.tree.set(node, N_S3_SET);
  });
  c.on(false, tCodeFlowValue, exitData);
  c.on(false, tCodeIndented, (FromMarkdown c, int token) => {
    string data = c.resume();
    c.tree.s1[c.top()] = stripTrailingEol(data);
    c.close(token);
  });
  c.on(false, tCodeText, (FromMarkdown c, int token) => {
    string data = c.resume();
    c.tree.s1[c.top()] = data;
    c.close(token);
  });
  c.on(false, tCodeTextData, exitData);
  c.on(false, tData, exitData);
  c.on(false, tDefinition, closer);
  c.on(false, tDefinitionDestinationString, (FromMarkdown c, int token) => {
    string data = c.resume();
    c.tree.s1[c.top()] = data;
  });
  c.on(false, tDefinitionLabelString, (FromMarkdown c, int token) => {
    string label = c.resume();
    int node = c.top();
    c.tree.label[node] = label;
    c.tree.identifier[node] = c.parser.identifier(normalizeIdentifier(c.slice(token)));
  });
  c.on(false, tDefinitionTitleString, (FromMarkdown c, int token) => {
    string data = c.resume();
    int node = c.top();
    c.tree.s2[node] = data;
    c.tree.set(node, N_S2_SET);
  });
  c.on(false, tEmphasis, closer);
  c.on(false, tHardBreakEscape, exitHardBreak);
  c.on(false, tHardBreakTrailing, exitHardBreak);
  c.on(false, tHtmlFlow, (FromMarkdown c, int token) => {
    string data = c.resume();
    c.tree.s1[c.top()] = data;
    c.close(token);
  });
  c.on(false, tHtmlFlowData, exitData);
  c.on(false, tHtmlText, (FromMarkdown c, int token) => {
    string data = c.resume();
    c.tree.s1[c.top()] = data;
    c.close(token);
  });
  c.on(false, tHtmlTextData, exitData);
  c.on(false, tImage, (FromMarkdown c, int token) => {
    setReferenceType(c, c.top());
    c.close(token);
  });
  c.on(false, tLabel, (FromMarkdown c, int token) => {
    int fragment = c.top();
    string value = c.resume();
    int node = c.top();
    c.inReference = true;
    if (c.tree.kind[node] == K_LINK) {
      c.tree.moveChildren(fragment, node);
    } else {
      c.tree.s3[node] = value;
      c.tree.set(node, N_S3_SET);
    }
  });
  c.on(false, tLabelText, (FromMarkdown c, int token) => {
    string text = c.slice(token);
    int ancestor = c.below();
    c.tree.label[ancestor] = decodeString(text);
    c.tree.identifier[ancestor] = c.parser.identifier(normalizeIdentifier(text));
  });
  c.on(false, tLineEnding, (FromMarkdown c, int token) => {
    int context = c.top();
    if (c.atHardBreak) {
      int tail = c.tree.lastChild[context];
      c.setEnd(tail, token);
      c.atHardBreak = false;
      return;
    }
    if (!c.setextHeadingSlurpLineEnding && c.canContainEols.includes(c.tree.kind[context])) {
      c.onEnterData(token);
      c.onExitData(token);
    }
  });
  c.on(false, tLink, (FromMarkdown c, int token) => {
    setReferenceType(c, c.top());
    c.close(token);
  });
  c.on(false, tListItem, closer);
  c.on(false, tListOrdered, closer);
  c.on(false, tListUnordered, closer);
  c.on(false, tParagraph, closer);
  c.on(false, tReferenceString, (FromMarkdown c, int token) => {
    string label = c.resume();
    int node = c.top();
    c.tree.label[node] = label;
    c.tree.identifier[node] = c.parser.identifier(normalizeIdentifier(c.slice(token)));
    c.referenceType = 2;
  });
  c.on(false, tResourceDestinationString, (FromMarkdown c, int token) => {
    string data = c.resume();
    c.tree.s1[c.top()] = data;
  });
  c.on(false, tResourceTitleString, (FromMarkdown c, int token) => {
    string data = c.resume();
    int node = c.top();
    c.tree.s2[node] = data;
    c.tree.set(node, N_S2_SET);
  });
  c.on(false, tResource, (FromMarkdown c, int token) => {
    c.inReference = false;
  });
  c.on(false, tSetextHeading, (FromMarkdown c, int token) => {
    c.setextHeadingSlurpLineEnding = false;
    c.close(token);
  });
  c.on(false, tSetextHeadingLineSequence, (FromMarkdown c, int token) => {
    c.tree.num[c.top()] = if (c.slice(token).codeUnitAt(0) == 61) { 1 } else { 2 };
  });
  c.on(false, tSetextHeadingText, (FromMarkdown c, int token) => {
    c.setextHeadingSlurpLineEnding = true;
  });
  c.on(false, tStrong, closer);
  c.on(false, tThematicBreak, closer);
}

// react-markdown 10.1.0: markdown to React elements. The pipeline (micromark, mdast, hast) is typed and
// flat; React, components and user callbacks are the only host values. Tags and properties are int ids
// (`TAG_*`, `PROP_*`, exported by the `constants` entry): `components` are `[tag, component, ...]` pairs,
// `allowedElements` and `disallowedElements` are tag ids, and `urlTransform` gets a property id.

import extern {Fragment, jsx, jsxs} from "react/jsx-runtime";
extern JsValue Fragment;
extern JsValue jsx;
extern JsValue jsxs;
extern JsValue String;

import { parseTree } from "./mdast/parse.lil";
import { Tree } from "./mdast/tree.lil";
import { ToHast, toHast, toHastTree } from "./hast/to-hast.lil";
import { H_ELEMENT, H_RAW, H_TEXT, HN_HAS_POSITION, P_NUMBER, PROP_HREF, PROP_SRC, TAG_A, TAG_IMG, TAG_INPUT, Hast, tagNames } from "./hast/hast.lil";
import { JsxOptions, componentTable, hastColumns, toJsxRuntime } from "./jsx/to-jsx.lil";
import { Pipeline, pipelineOf } from "./plugins.lil";

Regex safeProtocol = new Regex("^(https?|ircs?|mailto|xmpp)$", "i");

// Make a URL safe (react-markdown's `defaultUrlTransform`).
export string defaultUrlTransform(string value) {
  int colon = value.indexOf(":");
  int questionMark = value.indexOf("?");
  int numberSign = value.indexOf("#");
  int slash = value.indexOf("/");
  if (colon == -1 || (slash != -1 && colon > slash) || (questionMark != -1 && colon > questionMark) ||
      (numberSign != -1 && colon > numberSign) || safeProtocol.test(value.slice(0, colon))) {
    return value;
  }
  return "";
}

// html-url-attributes, over the properties the pipeline creates: `href` is a URL on a, area, base and
// link, `src` on audio, embed, iframe, img, input, script, source, track and video. Of those tags the
// pipeline creates a, img and input. (Upstream visits `href` before `src`; so does `visitChildren`.)
bool isUrl(int prop, int tag) {
  if (prop == PROP_HREF) {
    return tag == TAG_A;
  }
  return prop == PROP_SRC && (tag == TAG_IMG || tag == TAG_INPUT);
}

int[] urlProperties = [PROP_HREF, PROP_SRC];

// Tag ids from a host array (`allowedElements`, `disallowedElements`) as a set by tag id.
bool[] tagSet(JsValue tags) {
  bool[] set = [];
  for (int tag = 0; tag < tagNames.length; tag++) {
    set.push(false);
  }
  int length = JS.number(tags["length"]).toInt();
  for (int index = 0; index < length; index++) {
    int tag = JS.number(tags[index]).toInt();
    if (tag >= 0 && tag < set.length) {
      set[tag] = true;
    }
  }
  return set;
}

class Post {
  Hast h;
  JsValue options;
  // By tag id: whether `allowedElements` / `disallowedElements` remove it (and for tags past the set).
  bool filter;
  bool[] removed;
  bool removedPast;
  JsValue allowElement;
  JsValue urlTransform;
  bool skipHtml;
  bool unwrapDisallowed;
  // The hast columns, made once if a callback needs them (callbacks get node ids into them).
  JsValue columns;

  init(Hast h, JsValue options) {
    this.h = h;
    this.options = options;
    JsValue allowed = options["allowedElements"];
    JsValue disallowed = options["disallowedElements"];
    this.filter = bool(allowed) || bool(disallowed);
    this.removed = [];
    this.removedPast = bool(allowed);
    if (bool(allowed)) {
      this.removed = tagSet(allowed).map((bool kept) => !kept);
    } else if (bool(disallowed)) {
      this.removed = tagSet(disallowed);
    }
    this.allowElement = options["allowElement"];
    this.urlTransform = options["urlTransform"];
    this.skipHtml = bool(options["skipHtml"]);
    this.unwrapDisallowed = bool(options["unwrapDisallowed"]);
    this.columns = JS.undefined();
  }

  JsValue tree() {
    if (JS.isUndefined(this.columns)) {
      this.columns = hastColumns(this.h);
    }
    return this.columns;
  }
}

// Unlinks `node` from its parent; returns its next sibling.
int unlink(Hast h, int node) {
  int parent = h.parent[node];
  int previous = h.previousSibling[node];
  int next = h.nextSibling[node];
  if (previous >= 0) {
    h.nextSibling[previous] = next;
  } else {
    h.firstChild[parent] = next;
  }
  if (next >= 0) {
    h.previousSibling[next] = previous;
  } else {
    h.lastChild[parent] = previous;
  }
  return next;
}

// Replaces `node` by its children (`parent.children.splice(index, 1, ...node.children)`); returns the
// node now at its position.
int unwrap(Hast h, int node) {
  int parent = h.parent[node];
  int first = h.firstChild[node];
  if (first < 0) {
    return unlink(h, node);
  }
  int last = h.lastChild[node];
  int previous = h.previousSibling[node];
  int next = h.nextSibling[node];
  int child = first;
  while (child >= 0) {
    h.parent[child] = parent;
    child = h.nextSibling[child];
  }
  h.previousSibling[first] = previous;
  h.nextSibling[last] = next;
  if (previous >= 0) {
    h.nextSibling[previous] = first;
  } else {
    h.firstChild[parent] = first;
  }
  if (next >= 0) {
    h.previousSibling[next] = last;
  } else {
    h.lastChild[parent] = last;
  }
  return first;
}

// react-markdown's `transform`, applied the way unist-util-visit applies it: preorder, and a visitor
// that changes the parent's children resumes at the same index.
void visitChildren(Post post, int parent) {
  Hast h = post.h;
  int index = 0;
  int child = h.firstChild[parent];
  while (child >= 0) {
    int kind = h.kind[child];
    if (kind == H_RAW) {
      if (post.skipHtml) {
        child = unlink(h, child);
      } else {
        h.kind[child] = H_TEXT;
        h.flags[child] = h.flags[child] - (h.flags[child] & HN_HAS_POSITION);
      }
      continue;
    }
    if (kind == H_ELEMENT) {
      int tag = h.tag[child];
      for (int name of urlProperties) {
        int prop = h.findProperty(child, name);
        if (prop >= 0 && isUrl(name, tag)) {
          string value = if (h.pKind[prop] == P_NUMBER) { "" + h.pNum[prop] } else { h.pStr[prop] };
          string next = if (bool(post.urlTransform)) {
            JS.assume(JS.call(post.urlTransform, JS.undefined(), value, name, child, post.tree()))
          } else {
            defaultUrlTransform(value)
          };
          h.setString(child, name, next);
        }
      }
      bool remove = post.filter && (if (tag < post.removed.length) { post.removed[tag] } else { post.removedPast });
      if (!remove && bool(post.allowElement)) {
        remove = !bool(JS.call(post.allowElement, JS.undefined(), child, index, parent, post.tree()));
      }
      if (remove) {
        child = if (post.unwrapDisallowed) { unwrap(h, child) } else { unlink(h, child) };
        continue;
      }
      visitChildren(post, child);
    }
    index++;
    child = h.nextSibling[child];
  }
}

// `<Markdown {...options} />`: react-markdown's props. Callbacks and custom components get nodes as ids into
// `tree`, the hast columns (see `hastColumns`): `urlTransform(url, prop, node, tree)`,
// `allowElement(node, index, parent, tree)`, and `props.node` / `props.tree` for components.
export JsValue Markdown(JsValue options) {
  // As upstream's production build: `children` that is not a string renders nothing (its devlop check only throws
  // under the `development` condition), and `allowedElements` wins over `disallowedElements`.
  JsValue children = options["children"];
  string value = if (JS.typeOf(children) == "string") { JS.assume(children) } else { "" };
  // remark-parse with the plugins' syntax and mdast handlers, their mdast transforms, remark-rehype (to-hast's
  // defaults handle GFM nodes), the plugins' handlers and hast transforms.
  Pipeline plugins = pipelineOf(options, options["plugins"]);
  Tree mdast = parseTree(value, plugins.syntax, plugins.mdast);
  for (func(Tree)->void transform of plugins.remark) {
    transform(mdast);
  }
  ToHast state = toHastTree(mdast, true);
  // remark-rehype's footnote options, as props: `clobberPrefix`, `footnoteLabel`, `footnoteLabelTag` (a tag id),
  // `footnoteBackLabel` and `footnoteBackContent` (a string, or a function of the reference and rereference index).
  JsValue clobberPrefix = options["clobberPrefix"];
  if (JS.typeOf(clobberPrefix) == "string") {
    state.clobberPrefix = JS.assume(clobberPrefix);
  }
  if (bool(options["footnoteLabel"])) {
    state.footnoteLabel = JS.assume(String(options["footnoteLabel"]));
  }
  if (bool(options["footnoteLabelTag"])) {
    state.footnoteLabelTag = JS.number(options["footnoteLabelTag"]).toInt();
  }
  state.footnoteBackLabel = options["footnoteBackLabel"];
  state.footnoteBackContent = options["footnoteBackContent"];
  for (func(ToHast)->void install of plugins.hast) {
    install(state);
  }
  int root = toHast(state);
  for (func(Hast, int)->void transform of plugins.rehype) {
    transform(state.hast, root);
  }
  visitChildren(new Post(state.hast, options), root);
  JsxOptions jsxOptions = new JsxOptions(Fragment, jsx, jsxs, componentTable(options["components"]));
  jsxOptions.styles = plugins.styles;
  jsxOptions.parseStyle = plugins.parseStyle;
  jsxOptions.ignoreInvalidStyle = true;
  jsxOptions.passNode = true;
  return toJsxRuntime(state.hast, root, jsxOptions);
}

// mdast-util-gfm 3.1.0 (from-markdown side): autolink literal, footnote, strikethrough, table, task list item.
// Handlers are installed in upstream's order, so later ones override (table's `codeText`, task list's
// `paragraph`).

import { tAutolinkEmail, tAutolinkProtocol, tCodeText, tData, tParagraph } from "../micromark/types.lil";
import { unicodePunctuation, unicodeWhitespace } from "../micromark/codes.lil";
import { normalizeIdentifier } from "../micromark/util.lil";
import { FromMarkdown } from "../mdast/from-markdown.lil";
import { K_DELETE, K_FOOTNOTE_DEFINITION, K_FOOTNOTE_REFERENCE, K_LINK, K_LINK_REFERENCE, K_LIST_ITEM, K_PARAGRAPH, K_TABLE, K_TABLE_CELL, K_TABLE_ROW, K_TEXT, N_CHECKED, N_CHECKED_SET, N_HAS_POSITION, N_URL_SET, Tree } from "../mdast/tree.lil";
import { tGfmFootnoteCall, tGfmFootnoteCallString, tGfmFootnoteDefinition, tGfmFootnoteDefinitionLabelString, tLiteralAutolink, tLiteralAutolinkEmail, tLiteralAutolinkHttp, tLiteralAutolinkWww, tStrikethrough, tTable, tTableData, tTableHeader, tTableRow, tTaskListCheckValueChecked, tTaskListCheckValueUnchecked } from "./syntax/ids.lil";

Regex escapedPipe = new Regex("\\\\([\\\\|])", "g");

// --- the literal autolink transform (mdast-util-find-and-replace over text) -------------------

Regex urlPattern = new Regex("(https?:\\/\\/|www(?=\\.))([-.\\w]+)([^ \\t\\r\\n]*)", "gi");
Regex emailPattern = new Regex("(?<=^|\\s|\\p{P}|\\p{S})([-.\\w+]+)@([-\\w]+(?:\\.[-\\w]+)+)", "gu");
Regex wPrefix = new Regex("^w", "i");
Regex underscore = new Regex("_", "");
Regex alnum = new Regex("[a-zA-Z\\d]", "");
Regex trailPunctuation = new Regex("[!\"&'),.:;<>?\\]}]+$", "");
Regex labelEnd = new Regex("[-\\d_]$", "");

bool previousOk(string input, int index, bool email) {
  int code = if (index > 0) { input.codeUnitAt(index - 1) } else { -1 };
  return (index == 0 || unicodeWhitespace(code) || unicodePunctuation(code)) && (!email || code != 47);
}

bool isCorrectDomain(string domain) {
  string[] parts = domain.split(".");
  if (parts.length < 2) {
    return false;
  }
  string last = parts[parts.length - 1];
  string beforeLast = parts[parts.length - 2];
  if (last != "" && (underscore.test(last) || !alnum.test(last))) {
    return false;
  }
  if (beforeLast != "" && (underscore.test(beforeLast) || !alnum.test(beforeLast))) {
    return false;
  }
  return true;
}

int ccount(string value, int character) {
  int count = 0;
  for (int index = 0; index < value.length; index++) {
    if (value.codeUnitAt(index) == character) {
      count++;
    }
  }
  return count;
}

// `splitUrl`: [url, trail]; trail "" means none.
string[] splitUrl(string input) {
  JsValue trailExec = trailPunctuation.exec(input);
  if (JS.isNullish(trailExec)) {
    return [input, ""];
  }
  int at = JS.assume(trailExec.index);
  string url = input.slice(0, at);
  string trail = JS.assume(trailExec[0]);
  int closingParenIndex = trail.indexOf(")");
  int openingParens = ccount(url, 40);
  int closingParens = ccount(url, 41);
  while (closingParenIndex != -1 && openingParens > closingParens) {
    url += trail.slice(0, closingParenIndex + 1);
    trail = trail.slice(closingParenIndex + 1);
    closingParenIndex = trail.indexOf(")");
    closingParens++;
  }
  return [url, trail];
}

int linkNode(Tree tree, string url, string text) {
  int link = tree.create(K_LINK, N_URL_SET);
  tree.s1[link] = url;
  int child = tree.create(K_TEXT, 0);
  tree.s1[child] = text;
  tree.append(link, child);
  return link;
}

// Replaces text node `node` (under `parent`) by `nodes`; returns the node after them.
int replaceText(Tree tree, int parent, int node, int[] nodes) {
  int previous = tree.previousSibling[node];
  int next = tree.nextSibling[node];
  int last = previous;
  for (int child of nodes) {
    tree.parent[child] = parent;
    tree.previousSibling[child] = last;
    if (last >= 0) {
      tree.nextSibling[last] = child;
    } else {
      tree.firstChild[parent] = child;
    }
    last = child;
  }
  if (last >= 0) {
    tree.nextSibling[last] = next;
  } else {
    tree.firstChild[parent] = next;
  }
  if (next >= 0) {
    tree.previousSibling[next] = last;
  } else {
    tree.lastChild[parent] = last;
  }
  return next;
}

// One find-and-replace pass (`email` picks the pattern); runs on a text node, returns the node to continue at.
int handleText(Tree tree, int parent, int node, bool email) {
  Regex find = if (email) { emailPattern } else { urlPattern };
  string value = tree.s1[node];
  int[] nodes = [];
  int start = 0;
  bool change = false;
  find.lastIndex = 0;
  JsValue found = find.exec(value);
  while (!JS.isNullish(found)) {
    int position = JS.assume(found.index);
    string whole = JS.assume(found[0]);
    // The replacement: -2 for `false`, -1 for nothing, else nodes in `replacement`.
    int[] replacement = [];
    bool rejected = false;
    if (email) {
      string atext = JS.assume(found[1]);
      string label = JS.assume(found[2]);
      if (!previousOk(value, position, true) || labelEnd.test(label)) {
        rejected = true;
      } else {
        replacement.push(linkNode(tree, "mailto:" + atext + "@" + label, atext + "@" + label));
      }
    } else {
      string protocol = JS.assume(found[1]);
      string domain = JS.assume(found[2]);
      string path = JS.assume(found[3]);
      string prefix = "";
      if (!previousOk(value, position, false)) {
        rejected = true;
      } else {
        if (wPrefix.test(protocol)) {
          domain = protocol + domain;
          protocol = "";
          prefix = "http://";
        }
        if (!isCorrectDomain(domain)) {
          rejected = true;
        } else {
          string[] parts = splitUrl(domain + path);
          if (parts[0] == "") {
            rejected = true;
          } else {
            replacement.push(linkNode(tree, prefix + protocol + parts[0], protocol + parts[0]));
            if (parts[1] != "") {
              int tail = tree.create(K_TEXT, 0);
              tree.s1[tail] = parts[1];
              replacement.push(tail);
            }
          }
        }
      }
    }
    if (rejected) {
      find.lastIndex = position + 1;
    } else {
      if (start != position) {
        addText(tree, nodes, value.slice(start, position));
      }
      for (int child of replacement) {
        if (tree.kind[child] == K_TEXT) {
          addText(tree, nodes, tree.s1[child]);
        } else {
          nodes.push(child);
        }
      }
      start = position + whole.length;
      change = true;
    }
    found = find.exec(value);
  }
  if (!change) {
    return tree.nextSibling[node];
  }
  if (start < value.length) {
    addText(tree, nodes, value.slice(start));
  }
  return replaceText(tree, parent, node, nodes);
}

// `add`: merges adjacent text.
void addText(Tree tree, int[] nodes, string value) {
  if (nodes.length > 0 && tree.kind[nodes[nodes.length - 1]] == K_TEXT) {
    int previous = nodes[nodes.length - 1];
    tree.s1[previous] = tree.s1[previous] + value;
    return;
  }
  int text = tree.create(K_TEXT, 0);
  tree.s1[text] = value;
  nodes.push(text);
}

void visitTexts(Tree tree, int parent, bool ignored, bool email) {
  int child = tree.firstChild[parent];
  while (child >= 0) {
    int kind = tree.kind[child];
    if (kind == K_TEXT) {
      child = if (ignored) { tree.nextSibling[child] } else { handleText(tree, parent, child, email) };
      continue;
    }
    visitTexts(tree, child, ignored || kind == K_LINK || kind == K_LINK_REFERENCE, email);
    child = tree.nextSibling[child];
  }
}

func(Tree)->void transformGfmAutolinkLiterals = (Tree tree) => {
  visitTexts(tree, 0, false, false);
  visitTexts(tree, 0, false, true);
};

export void installGfmFromMarkdown(FromMarkdown c) {
  bool inTable = false;

  // Autolink literal.
  c.on(true, tLiteralAutolink, (FromMarkdown c, int token) => {
    c.open(c.tree.create(K_LINK, N_URL_SET), token);
  });
  func(FromMarkdown, int)->void enterValue = (FromMarkdown c, int token) => {
    c.enter[tAutolinkProtocol](c, token);
  };
  c.on(true, tLiteralAutolinkEmail, enterValue);
  c.on(true, tLiteralAutolinkHttp, enterValue);
  c.on(true, tLiteralAutolinkWww, enterValue);
  c.on(false, tLiteralAutolink, (FromMarkdown c, int token) => {
    c.close(token);
  });
  c.on(false, tLiteralAutolinkEmail, (FromMarkdown c, int token) => {
    c.exit[tAutolinkEmail](c, token);
  });
  c.on(false, tLiteralAutolinkHttp, (FromMarkdown c, int token) => {
    c.exit[tAutolinkProtocol](c, token);
  });
  c.on(false, tLiteralAutolinkWww, (FromMarkdown c, int token) => {
    c.exit[tData](c, token);
    c.tree.s1[c.top()] = "http://" + c.slice(token);
  });
  c.transforms.push(transformGfmAutolinkLiterals);

  // Footnotes.
  c.on(true, tGfmFootnoteCallString, (FromMarkdown c, int token) => {
    c.buffer();
  });
  c.on(true, tGfmFootnoteCall, (FromMarkdown c, int token) => {
    c.open(c.tree.create(K_FOOTNOTE_REFERENCE, 0), token);
  });
  c.on(true, tGfmFootnoteDefinitionLabelString, (FromMarkdown c, int token) => {
    c.buffer();
  });
  c.on(true, tGfmFootnoteDefinition, (FromMarkdown c, int token) => {
    c.open(c.tree.create(K_FOOTNOTE_DEFINITION, 0), token);
  });
  func(FromMarkdown, int)->void exitLabelString = (FromMarkdown c, int token) => {
    string label = c.resume();
    int node = c.top();
    c.tree.identifier[node] = c.parser.identifier(normalizeIdentifier(c.slice(token)));
    c.tree.label[node] = label;
  };
  c.on(false, tGfmFootnoteCallString, exitLabelString);
  c.on(false, tGfmFootnoteDefinitionLabelString, exitLabelString);
  func(FromMarkdown, int)->void exitNode = (FromMarkdown c, int token) => {
    c.close(token);
  };
  c.on(false, tGfmFootnoteCall, exitNode);
  c.on(false, tGfmFootnoteDefinition, exitNode);

  // Strikethrough.
  c.canContainEols.push(K_DELETE);
  c.on(true, tStrikethrough, (FromMarkdown c, int token) => {
    c.open(c.tree.create(K_DELETE, 0), token);
  });
  c.on(false, tStrikethrough, exitNode);

  // Table.
  c.on(true, tTable, (FromMarkdown c, int token) => {
    int node = c.tree.create(K_TABLE, 0);
    // The alignment run the syntax left in the token's `aux` (the tree's `aux` is the same array).
    c.tree.num[node] = c.tokens.marker[token];
    c.open(node, token);
    inTable = true;
  });
  func(FromMarkdown, int)->void enterCell = (FromMarkdown c, int token) => {
    c.open(c.tree.create(K_TABLE_CELL, 0), token);
  };
  c.on(true, tTableData, enterCell);
  c.on(true, tTableHeader, enterCell);
  c.on(true, tTableRow, (FromMarkdown c, int token) => {
    c.open(c.tree.create(K_TABLE_ROW, 0), token);
  });
  c.on(false, tCodeText, (FromMarkdown c, int token) => {
    string value = c.resume();
    if (inTable) {
      value = JS.assume(JS.invoke(value, "replace", escapedPipe, (JsValue whole, JsValue character) => if (character == "|") { character } else { whole }));
    }
    c.tree.s1[c.top()] = value;
    c.close(token);
  });
  c.on(false, tTable, (FromMarkdown c, int token) => {
    c.close(token);
    inTable = false;
  });
  c.on(false, tTableData, exitNode);
  c.on(false, tTableHeader, exitNode);
  c.on(false, tTableRow, exitNode);

  // Task list item.
  func(FromMarkdown, int)->void exitCheck = (FromMarkdown c, int token) => {
    int node = c.below();
    c.tree.set(node, N_CHECKED_SET);
    if (c.tokens.type[token] == tTaskListCheckValueChecked) {
      c.tree.set(node, N_CHECKED);
    } else {
      c.tree.unset(node, N_CHECKED);
    }
  };
  c.on(false, tTaskListCheckValueChecked, exitCheck);
  c.on(false, tTaskListCheckValueUnchecked, exitCheck);
  c.on(false, tParagraph, (FromMarkdown c, int token) => {
    Tree tree = c.tree;
    int parent = if (c.stack.length > 1) { c.below() } else { -1 };
    if (parent >= 0 && tree.kind[parent] == K_LIST_ITEM && tree.has(parent, N_CHECKED_SET)) {
      int node = c.top();
      int head = tree.firstChild[node];
      if (head >= 0 && tree.kind[head] == K_TEXT) {
        int firstParagraph = -1;
        int sibling = tree.firstChild[parent];
        while (sibling >= 0) {
          if (tree.kind[sibling] == K_PARAGRAPH) {
            firstParagraph = sibling;
            break;
          }
          sibling = tree.nextSibling[sibling];
        }
        if (firstParagraph == node) {
          tree.s1[head] = tree.s1[head].slice(1);
          if (tree.s1[head].length == 0) {
            int next = tree.nextSibling[head];
            tree.firstChild[node] = next;
            if (next >= 0) {
              tree.previousSibling[next] = -1;
            } else {
              tree.lastChild[node] = -1;
            }
          } else if (tree.has(node, N_HAS_POSITION) && tree.has(head, N_HAS_POSITION)) {
            // Upstream moves the column and offset one on (a space or tab, so the same line).
            tree.sOffset[head] = tree.sOffset[head] + 1;
            tree.sOffset[node] = tree.sOffset[head];
          }
        }
      }
    }
    c.close(token);
  });
}

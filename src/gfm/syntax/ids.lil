// The GFM range of the family's int vocabularies: token types (from `TYPES_GFM`) and construct ids (from
// `CONSTRUCTS_GFM`, upstream's construct names, which `disable` lists).

import { TYPES_GFM } from "../../micromark/types.lil";
import { CONSTRUCTS_GFM } from "../../micromark/tokenizer.lil";

export const int tStrikethrough = TYPES_GFM;

// lil2-react-markdown/full: the core with remark-gfm, remark-math, remark-breaks and rehype-katex compiled in.
// `<Markdown plugins={[GFM, MATH, KATEX]}>` applies them, as `remarkPlugins={[remarkGfm, remarkMath]}` and
// `rehypePlugins={[rehypeKatex]}` do upstream (`BREAKS` is remark-breaks). KaTeX is the `katex` package,
// loaded first.
import { katex } from "./katex/host.lil";
import { Markdown, defaultUrlTransform } from "./react-markdown.lil";
import { PLUGIN_BREAKS, PLUGIN_GFM, PLUGIN_KATEX, PLUGIN_MATH } from "./plugins.lil";
import { gfmRegistered } from "./gfm-plugin.lil";
import { breaksRegistered, katexRegistered, mathRegistered } from "./math-plugin.lil";

export const int GFM = PLUGIN_GFM;
export const int MATH = PLUGIN_MATH;
export const int KATEX = PLUGIN_KATEX;
export const int BREAKS = PLUGIN_BREAKS;
export { Markdown, defaultUrlTransform };

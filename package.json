{
  "name": "@itslil/lil2-react-markdown",
  "version": "0.1.0",
  "description": "react-markdown on the typed, flat lil2 pipeline: same React output, smaller and faster",
  "type": "module",
  "license": "MIT",
  "author": "yeargun",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeargun/lil2-react-markdown.git"
  },
  "bugs": {
    "url": "https://github.com/yeargun/lil2-react-markdown/issues"
  },
  "homepage": "https://yeargun.github.io/lil2-react-markdown/",
  "keywords": [
    "react",
    "react-markdown",
    "markdown",
    "commonmark",
    "gfm",
    "katex",
    "component",
    "lilscript",
    "lil2",
    "typed",
    "fast"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/react-markdown.js",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "convex": "./dist/react-markdown.js",
      "deno": "./dist/react-markdown.js",
      "edge-light": "./dist/react-markdown.js",
      "react-native": "./dist/react-markdown.js",
      "worker": "./dist/react-markdown.js",
      "workerd": "./dist/react-markdown.js",
      "browser": "./dist/browser/react-markdown.js",
      "default": "./dist/react-markdown.js"
    },
    "./gfm": {
      "types": "./types/gfm.d.ts",
      "convex": "./dist/gfm.js",
      "deno": "./dist/gfm.js",
      "edge-light": "./dist/gfm.js",
      "react-native": "./dist/gfm.js",
      "worker": "./dist/gfm.js",
      "workerd": "./dist/gfm.js",
      "browser": "./dist/browser/gfm.js",
      "default": "./dist/gfm.js"
    },
    "./full": {
      "types": "./types/full.d.ts",
      "convex": "./dist/full.js",
      "deno": "./dist/full.js",
      "edge-light": "./dist/full.js",
      "react-native": "./dist/full.js",
      "worker": "./dist/full.js",
      "workerd": "./dist/full.js",
      "browser": "./dist/browser/full.js",
      "default": "./dist/full.js"
    },
    "./constants": {
      "types": "./types/constants.d.ts",
      "convex": "./dist/constants.js",
      "deno": "./dist/constants.js",
      "edge-light": "./dist/constants.js",
      "react-native": "./dist/constants.js",
      "worker": "./dist/constants.js",
      "workerd": "./dist/constants.js",
      "browser": "./dist/browser/constants.js",
      "default": "./dist/constants.js"
    }
  },
  "files": [
    "dist/**/*.js",
    "types",
    "NOTICE.md"
  ],
  "peerDependencies": {
    "react": ">=18",
    "katex": "^0.16.22"
  },
  "peerDependenciesMeta": {
    "katex": {
      "optional": true
    }
  },
  "scripts": {
    "check:sources": "node scripts/shared-sources.mjs",
    "build:dev": "node scripts/build.mjs --dev",
    "build": "node scripts/build.mjs",
    "test": "npm run check:sources && node --test test/differential.test.mjs test/gfm.test.mjs test/full.test.mjs"
  },
  "devDependencies": {
    "character-entities": "2.0.2",
    "commonmark.json": "^0.31.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-markdown": "10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  }
}
